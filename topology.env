# ---------------------------------------------------------------------------
# Topology definition for the IOS-XRv9000 lab.
# Sourced by lab.sh -- edit here, not in the scripts.
#
#            Gi0/0/0/0 .1 <--- link1 (10.1.1.0/30) ---> .2 Gi0/0/0/0
#   +-----+                                                     +-----+
#   | xr1 |                                                     | xr2 |
#   +-----+                                                     +-----+
#            Gi0/0/0/1 .1 <--- link2 (10.1.2.0/30) ---> .2 Gi0/0/0/1
#       |                                                         |
#       | MgmtEth0/RP0/CPU0/0                 MgmtEth0/RP0/CPU0/0 |
#       | 10.99.0.11                                   10.99.0.12 |
#       +--------------------+                +---------------------+
#                            |                |
#                     ======= OOB 10.99.0.0/24 =======
#                                    |
#                              +-----------+
#                              |    nms    | 10.99.0.10
#                              +-----------+
#                                    | (QEMU user-mode NAT, SSH forward)
#                                  host
#
#   A third link leaves xr1 for an external BGP speaker:
#
#       xr1 Gi0/0/0/2 10.2.1.1/30 <---> 10.2.1.2/30 gobgp (AS 65100)
#
#   gobgp originates 100 prefixes into xr1 over eBGP; xr1 passes them on to
#   xr2 with next-hop-self.
#
#   The routers' management ports are on the OOB network, not on QEMU NAT:
#   XRv9k has only one management interface, so it cannot be on both. nms is
#   the way in from the host -- it has a NAT interface with an SSH forward and
#   acts as the jump host for the routers (see lab.sh ssh / tests/XrCli.py).
# ---------------------------------------------------------------------------

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_IMAGE="$PROJECT_DIR/xrv9k-fullk9-x-26.1.1.qcow2"
# Both Linux nodes come from the same Ubuntu cloud image.
LINUX_BASE_IMAGE="$PROJECT_DIR/images/ubuntu-24.04-minimal-cloudimg-amd64.img"
NMS_BASE_IMAGE="$LINUX_BASE_IMAGE"
# gobgpd rides into the VM on its seed image, so the guest needs no internet.
# Fetch once with:
#   curl -sSLo images/gobgp_4.9.0_linux_amd64.tar.gz \
#     https://github.com/osrg/gobgp/releases/download/v4.9.0/gobgp_4.9.0_linux_amd64.tar.gz
GOBGP_TARBALL="$PROJECT_DIR/images/gobgp_4.9.0_linux_amd64.tar.gz"
RUN_DIR="$PROJECT_DIR/run"
CFG_DIR="$PROJECT_DIR/configs"

# Per-router resources. 20 GiB is not optional: the image's own boot arguments
# carry hugepages=6 (6 x 1 GiB), which is the allocation Cisco's platform
# code expects only when the guest has more than
# PLATFORM_SYS_MEM_GB_THRESHOLD_DOUBLE_HUGEPAGES = 18 GiB of RAM. Give a node
# 16 GiB and its host OS wedges in "Spirit early boot setup" before XR ever
# starts. See README.md.
VM_RAM_MB="${VM_RAM_MB:-20480}"
VM_VCPUS="${VM_VCPUS:-4}"

# The Linux VMs need very little.
NMS_RAM_MB="${NMS_RAM_MB:-1024}"
NMS_VCPUS="${NMS_VCPUS:-1}"
GOBGP_RAM_MB="${GOBGP_RAM_MB:-1024}"
GOBGP_VCPUS="${GOBGP_VCPUS:-1}"

# Every node lab.sh manages, and the subset that runs IOS-XR. nms is listed
# first so it boots before the routers: it hosts nothing they depend on, but
# having the syslog server up first means their boot messages are captured.
NODES=(nms gobgp xr1 xr2)
XR_NODES=(xr1 xr2)
declare -A NODE_KIND=(  [nms]=linux [gobgp]=linux [xr1]=xr [xr2]=xr )
# Per-node RAM/vCPU for the Linux nodes, so start_linux_node stays generic.
declare -A LINUX_RAM=(   [nms]="$NMS_RAM_MB"  [gobgp]="$GOBGP_RAM_MB" )
declare -A LINUX_VCPUS=( [nms]="$NMS_VCPUS"   [gobgp]="$GOBGP_VCPUS"  )

# Host-side TCP ports. Chosen to sit clear of the c8000v labs already using
# 2221-2223 / 2231-2233 / 2241 / 5001-5003 / 5011-5013 / 5021.
# Only nms gets a host SSH forward: a router's management port is on the OOB
# network, so there is no host port to map it to (reach it through nms).
declare -A SSH_PORT=(     [nms]=2261  [gobgp]=2262 )
declare -A MONITOR_PORT=( [nms]=4121  [gobgp]=4131 [xr1]=4101  [xr2]=4111  )
# XRv9k exposes four serial ports; the first is the XR console. Ports are
# allocated as CONSOLE_BASE .. CONSOLE_BASE+3. nms uses one.
declare -A CONSOLE_BASE=( [nms]=5121  [gobgp]=5131 [xr1]=5101  [xr2]=5111  )

# MAC prefix per node (last octet = NIC index).
declare -A MAC_PREFIX=( [nms]=52:54:00:e9:03 [gobgp]=52:54:00:e9:04 \
                        [xr1]=52:54:00:e9:01 [xr2]=52:54:00:e9:02 )

# The two inter-router links. Each is a pair of unicast UDP sockets on
# loopback -- one endpoint port per node per link -- which makes each link a
# true point-to-point wire. Multicast sockets (mcast=) would be simpler to
# extend to a third node, but QEMU loops multicast frames back to the sender,
# so every node would see itself as its own CDP neighbour and as a duplicate
# on the wire.
declare -A LINK1_PORT=( [xr1]=11001 [xr2]=11002 )
declare -A LINK2_PORT=( [xr1]=11003 [xr2]=11004 )
# Who is on the other end of both links.
declare -A LINK_PEER=(  [xr1]=xr2   [xr2]=xr1   )

# xr1's third data link, to the external BGP speaker. Same unicast UDP pair
# as the inter-router links, and only xr1 has it -- which is why xr1 gets a
# sixth vNIC and xr2 does not.
GOBGP_LINK_PORT_XR1=11005
GOBGP_LINK_PORT_GOBGP=11006
GOBGP_LINK_SUBNET="10.2.1.0/30"
GOBGP_LINK_IP_XR1="10.2.1.1"
GOBGP_LINK_IP_GOBGP="10.2.1.2"
GOBGP_AS=65100
GOBGP_PREFIX_COUNT=10000

# The OOB management network: one shared segment for all three nodes, so here
# a multicast socket is the right primitive rather than a UDP pair. QEMU's
# multicast loopback -- the reason the router-to-router links avoid it -- does
# not matter on this segment: no link-layer neighbour protocol runs on it
# (CDP is enabled only on the data interfaces), and a node ignores IP frames
# that carry its own source MAC.
OOB_MCAST="230.31.0.1:11099"
OOB_SUBNET="10.99.0.0/24"
declare -A OOB_IP=( [nms]=10.99.0.10 [xr1]=10.99.0.11 [xr2]=10.99.0.12 )

# Credentials. XR's come from configs/<node>.cfg, nms's from the cloud-init
# seed lab.sh builds; both are repeated here so lab.sh can print them.
XR_USER="admin"
XR_PASSWORD="Admin@12345"
NMS_USER="lab"
NMS_PASSWORD="Lab_123!"

# Small unique index per node, used to allocate QEMU hub ids for the
# CtrlEth/DevEth placeholder NICs.
declare -A NODE_INDEX=( [xr1]=1 [xr2]=2 )

# The XRv9k qcow2 is GPT/UEFI-only (its protective MBR carries no legacy boot
# code), so the routers must be given OVMF firmware rather than SeaBIOS. Each
# gets a private, writable copy of the variable store. The Ubuntu cloud image
# boots fine on SeaBIOS and does not use these.
OVMF_CODE="${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}"
OVMF_VARS_TEMPLATE="${OVMF_VARS_TEMPLATE:-/usr/share/OVMF/OVMF_VARS_4M.fd}"

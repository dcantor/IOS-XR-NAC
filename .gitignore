# --- VM images -------------------------------------------------------------
# The XRv9000 image is Cisco-licensed and 2 GB; it is not redistributable and
# has to be supplied by whoever runs the lab. The Ubuntu cloud image and the
# gobgpd release are both freely downloadable -- see README.md -- so they are
# fetched rather than committed.
*.qcow2
*.img
images/

# --- runtime state ---------------------------------------------------------
# Overlay disks (several GB each), generated ISOs, UEFI variable stores,
# pidfiles and console logs. All rebuilt by ./lab.sh start.
run/

# --- test and tooling artefacts -------------------------------------------
# test_results/ is deliberately NOT ignored: the committed report.html and
# log.html are the record of what this lab was last verified to do. Note
# that GitHub will not render them in the browser -- they have to be
# downloaded, or viewed through a raw-HTML proxy.
#
# output.xml is Robot's machine-readable source for those two files; it is
# left out to keep the runs to the HTML that is actually read. Drop this line
# if you want it (it is what `rebot` needs to merge or re-render runs).
test_results/**/output.xml
.venv/
__pycache__/
*.pyc

# --- terraform -------------------------------------------------------------
# Provider binaries are large and platform-specific; state is machine-local.
# The lock file IS committed (see nac/.gitignore note) so the versions that
# are known to work are pinned.
nac/.terraform/
nac/terraform.tfstate
nac/terraform.tfstate.backup
